{
  "name": "blockcraft-battle-ground",
  "version": "1.0.0",
  "private": true,
  "description": "A procedurally generated voxel world with online gunfights, combat construction, optical weapon scopes and dragons. three.js, no build step, no dependencies.",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "test": "node --test --test-concurrency=1 tests/regression.test.cjs",
    "test:syntax": "node tests/check-syntax.cjs",
    "test:boot": "node --test --test-name-pattern=boot tests/regression.test.cjs",
    "test:ui": "node --test --test-name-pattern=UI tests/regression.test.cjs",
    "test:lan": "node --test --test-name-pattern=LAN tests/regression.test.cjs"
  },
  "keywords": [
    "voxel",
    "game",
    "threejs",
    "webgl",
    "multiplayer",
    "mqtt",
    "shooter"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=16"
  }
}
